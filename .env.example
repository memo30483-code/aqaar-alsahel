# قالب متغيّرات البيئة — انسخه إلى .env.local واملأ القيم الحقيقية.
# لا تضع أي قيمة حقيقية في هذا الملف ولا ترفعه إلى Git.

# ==== جلسة الأدمن (السيرفر فقط) ====
# بريد الأدمن وكلمة مروره — يُتحقق منهما في /api/admin/login فقط
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
# مفتاح توقيع الكوكي — سلسلة عشوائية طويلة (64 حرفًا على الأقل)
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# الاسم الظاهر في لوحة التحكم (اختياري)
ADMIN_NAME=مدير النظام

# ==== قاعدة البيانات والتخزين (Supabase) ====
# Project URL من: Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# مفتاح service_role (سري — السيرفر فقط، لا يُوضع في NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# بديل اختياري للعميل (غير مطلوب حاليًا لأن كل الوصول يمر عبر /api)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
