# قالب متغيّرات البيئة — انسخه إلى .env.local واملأ القيم الحقيقية.
# لا تضع أي قيمة حقيقية في هذا الملف ولا ترفعه إلى Git.

# ==== جلسة الأدمن (السيرفر فقط) ====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
USER_SESSION_SECRET=replace-with-a-separate-long-random-secret
ADMIN_NAME=مدير النظام

# ==== قاعدة البيانات والتخزين (Supabase) ====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# لا يحتاج التطبيق الحالي anon key؛ كل الوصول يمر عبر السيرفر.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==== توقيع OTP ====
# اختياري؛ عند غيابه يستخدم ADMIN_SESSION_SECRET مع فصل نطاق التوقيع.
OTP_SECRET=replace-with-an-independent-long-random-secret

# ==== Email OTP — إلزامي قبل فتح تسجيل الحسابات (Resend) ====
# التسجيل يفشل مغلقًا إذا لم يتم ضبط المفتاح وعنوان مرسل موثّق.
RESEND_API_KEY=
OTP_EMAIL_FROM=verify@example.com

# ==== SMS OTP — اختياري ولا توجد اتصالات أو تكلفة وهو معطّل ====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# ==== WhatsApp OTP — اختياري ولا توجد اتصالات أو تكلفة وهو معطّل ====
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
